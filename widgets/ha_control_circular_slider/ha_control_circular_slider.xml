<widget>
	<previews>
		<preview width="320" height="240" style_bg_color="0xeee" />
	</previews>

	<api>
		<enumdef name="circular_slider_mode">
			<enum name="START" value="0" />
			<enum name="END" value="1" />
			<enum name="FULL" value="2" />
		</enumdef>
		<prop name="current" type="int" default="40" />
		<prop name="value" type="int" default="50" />
		<prop name="low" type="int" default="20" />
		<prop name="high" type="int" default="80" />
		<prop name="dual" type="bool" default="false" />
		<prop name="min" type="int" default="0" />
		<prop name="max" type="int" default="100" />
		<prop name="step" type="int" default="1" />
		<prop name="size" type="int" default="320" />
		<prop name="low_color" type="color" />
		<prop name="high_color" type="color" />
		<prop name="active_color" type="color" />
		<prop name="mode" type="enum:circular_slider_mode" default="START" />
		<prop name="inactive" type="bool" default="0" />
		<prop name="show_knob" type="bool" default="1" />
	</api>

	<styles>
		<style name="style_base" bg_opa="0%" />
		<style name="low_arc_main" arc_opa="0%" />
		<style name="low_arc_indicator" arc_color="0xffb790" arc_opa="100%" />
		<style name="low_arc_knob" opa="0%" />
		<style name="low_active_arc_main" arc_opa="0%" />
		<style name="low_active_arc_indicator" arc_color="0xff6f22" arc_opa="100%" />
		<style name="low_active_arc_knob" opa="0%" />
		<style name="high_arc_main" arc_opa="0%" />
		<style name="high_arc_indicator" arc_color="0x90caf9" arc_opa="100%" />
		<style name="high_arc_knob" opa="0%" />
		<style name="high_active_arc_main" arc_opa="0%" />
		<style name="high_active_arc_indicator" arc_color="0x2196f3" arc_opa="100%" />
		<style name="high_active_arc_knob" opa="0%" />
		<style name="bg_arc_knob" opa="0%" />
		<style name="bg_arc_main" arc_color="0xe0e0e0" arc_opa="30%" />
		<style name="bg_arc_indicator" arc_opa="0%" />
		<style name="dot_arc_main" arc_opa="0%" />
		<style name="dot_arc_indicator" arc_opa="0%" />
		<style name="cur_dot_arc_knob" opa="50%" bg_color="0x212121" pad_all="-2" />
		<style name="low_dot_arc_knob" opa="100%" bg_color="0xFFFFFF" pad_all="-2" />
		<style name="high_dot_arc_knob" opa="100%" bg_color="0xFFFFFF" pad_all="-2" />
		<style name="touch_arc_knob" opa="0%" />
		<style name="touch_arc_main" arc_opa="0%" />
		<style name="touch_arc_indicator" arc_opa="0%" />
	</styles>

	<view extends="lv_obj">
		<style name="style_base" />

		<lv_arc
			name="bg_arc"
			bg_start_angle="0"
			bg_end_angle="270"
			start_angle="0"
			end_angle="270"
			value="0"
			min_value="0"
			max_value="100"
			rotation="135"
			clickable="false"
		>
			<style name="bg_arc_main" selector="main" />
			<style name="bg_arc_indicator" selector="indicator" />
			<style name="bg_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="low_arc"
			bg_start_angle="0"
			bg_end_angle="70"
			start_angle="0"
			end_angle="70"
			value="1"
			min_value="0"
			max_value="1"
			rotation="135"
			clickable="false"
		>
			<style name="low_arc_main" selector="main" />
			<style name="low_arc_indicator" selector="indicator" />
			<style name="low_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="low_active_arc"
			bg_start_angle="70"
			bg_end_angle="170"
			start_angle="70"
			end_angle="170"
			value="1"
			min_value="0"
			max_value="1"
			rotation="135"
			clickable="false"
		>
			<style name="low_active_arc_main" selector="main" />
			<style name="low_active_arc_indicator" selector="indicator" />
			<style name="low_active_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="high_arc"
			bg_start_angle="170"
			bg_end_angle="230"
			start_angle="170"
			end_angle="230"
			value="1"
			min_value="0"
			max_value="1"
			rotation="135"
			clickable="false"
		>
			<style name="high_arc_main" selector="main" />
			<style name="high_arc_indicator" selector="indicator" />
			<style name="high_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="high_active_arc"
			bg_start_angle="230"
			bg_end_angle="270"
			start_angle="230"
			end_angle="270"
			value="1"
			min_value="0"
			max_value="1"
			rotation="135"
			clickable="false"
		>
			<style name="high_active_arc_main" selector="main" />
			<style name="high_active_arc_indicator" selector="indicator" />
			<style name="high_active_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="cur_dot_knob_arc"
			bg_start_angle="0"
			bg_end_angle="270"
			start_angle="0"
			end_angle="270"
			value="40"
			min_value="0"
			max_value="100"
			rotation="135"
			clickable="false"
		>
			<style name="dot_arc_main" selector="main" />
			<style name="dot_arc_main" selector="indicator" />
			<style name="cur_dot_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="low_dot_knob_arc"
			bg_start_angle="0"
			bg_end_angle="270"
			start_angle="0"
			end_angle="270"
			value="50"
			min_value="0"
			max_value="100"
			rotation="135"
			clickable="false"
		>
			<style name="dot_arc_main" selector="main" />
			<style name="dot_arc_main" selector="indicator" />
			<style name="low_dot_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="high_dot_knob_arc"
			bg_start_angle="0"
			bg_end_angle="270"
			start_angle="0"
			end_angle="270"
			value="80"
			min_value="0"
			max_value="100"
			rotation="135"
			clickable="false"
		>
			<style name="dot_arc_main" selector="main" />
			<style name="dot_arc_main" selector="indicator" />
			<style name="low_dot_arc_knob" selector="knob" />
		</lv_arc>

		<lv_arc
			name="touch_arc"
			bg_start_angle="0"
			bg_end_angle="270"
			start_angle="0"
			end_angle="270"
			value="30"
			min_value="0"
			max_value="100"
			rotation="135"
		>
			<style name="touch_arc_main" selector="main" />
			<style name="touch_arc_indicator" selector="indicator" />
			<style name="touch_arc_knob" selector="knob" />
		</lv_arc>
	</view>
</widget>
