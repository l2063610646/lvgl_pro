<widget>
	<previews>
		<preview width="320" height="60" style_bg_color="0x212121" />
	</previews>

	<api>
		<prop name="value" type="string" default="" help="Selected value" />
		<prop name="options" type="string" default="" help="Semicolon-separated options (value,label,symbol,color)" />
		<prop name="label" type="string" default="" help="Control label" />
		<prop name="disabled" type="bool" default="false" help="Disabled state" />
		<prop name="vertical" type="bool" default="false" help="Vertical layout orientation" />
		<prop name="hide_option_label" type="bool" default="false" help="Hide text labels in options" />
		<prop name="color" type="color" default="0xFF6F22" help="Default selected option highlight color" />
		<prop name="height" type="px" default="44" help="Height of the control" />
	</api>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="44"
			radius="12"
			bg_color="0x727272"
			bg_opa="20%"
			pad_all="4"
			pad_column="4"
			pad_row="4"
			border_width="0"
			clip_corner="true"
		/>
	</styles>

	<view
		name="main"
		extends="lv_buttonmatrix"
		scrollable="false"
	>
		<remove_style_all />
		<style name="style_base" />
	</view>
</widget>
