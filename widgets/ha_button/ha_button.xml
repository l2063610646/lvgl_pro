<widget>
	<previews>
		<preview width="200" height="80" style_bg_color="0x212121" />
	</previews>

	<api>
		<enumdef name="ha_button_variant">
			<enum name="BRAND" value="0" />
			<enum name="NEUTRAL" value="1" />
			<enum name="SUCCESS" value="2" />
			<enum name="WARNING" value="3" />
			<enum name="DANGER" value="4" />
		</enumdef>

		<enumdef name="ha_button_appearance">
			<enum name="ACCENT" value="0" />
			<enum name="FILLED" value="1" />
			<enum name="PLAIN" value="2" />
			<enum name="OUTLINED" value="3" />
		</enumdef>

		<enumdef name="ha_button_size">
			<enum name="XS" value="0" />
			<enum name="S" value="1" />
			<enum name="M" value="2" />
			<enum name="L" value="3" />
			<enum name="XL" value="4" />
		</enumdef>

		<prop name="label" type="string" default="Button" help="Button text label" />
		<prop name="text" type="string" default="" help="Alias for label" />
		<prop name="start_icon" type="string" default="" help="Prefix icon symbol" />
		<prop name="start_symbol" type="string" default="" help="Alias for start_icon" />
		<prop name="end_icon" type="string" default="" help="Suffix icon symbol" />
		<prop name="end_symbol" type="string" default="" help="Alias for end_icon" />
		<prop name="variant" type="enum:ha_button_variant" default="HA_BUTTON_VARIANT_BRAND" help="Color variant" />
		<prop name="appearance" type="enum:ha_button_appearance" default="HA_BUTTON_APPEARANCE_ACCENT" help="Visual appearance style" />
		<prop name="size" type="enum:ha_button_size" default="HA_BUTTON_SIZE_M" help="Button size" />
		<prop name="height" type="px" default="0" help="Custom button height" />
		<prop name="disabled" type="bool" default="false" help="Disabled state" />
		<prop name="loading" type="bool" default="false" help="Loading state" />
		<prop name="selected" type="bool" default="false" help="Selected state" />
		<prop name="fg_color" type="color" default="0xffffff" help="Custom foreground color" />
		<prop name="bg_color" type="color" default="0x009ac7" help="Custom background/accent color" />
		<prop name="border_color" type="color" default="0x009ac7" help="Custom border color" />
	</api>

	<styles>
		<style
			name="style_base"
			width="content"
			height="40"
			radius="20"
			pad_hor="16"
			pad_ver="0"
			bg_opa="100%"
			border_width="0"
			layout="flex"
			flex_flow="row"
			flex_main_place="center"
			flex_cross_place="center"
			flex_track_place="center"
			pad_column="4"
			clip_corner="true"
		/>
	</styles>

	<view
		extends="lv_obj"
		scrollable="false"
		clickable="true"
	>
		<remove_style_all />
		<style name="style_base" />

		<lv_label name="start_icon_obj" text="" style_text_font="mdi_icon_font18_4" />
		<lv_label name="label_obj" text="Button" style_text_font="roboto_regular_14_4" />
		<lv_label name="end_icon_obj" text="" style_text_font="mdi_icon_font18_4" />
		<lv_spinner name="spinner_obj" width="18" height="18" hidden="true" />
	</view>
</widget>
