<widget>
	<previews>
		<preview width="240" height="60" style_bg_color="0x212121" />
	</previews>

	<api>
		<prop name="value" type="string" default="" help="Selected value" />
		<prop name="options" type="string" default="" help="Semicolon-separated options (value,label,symbol)" />
		<prop name="label" type="string" default="" help="Control label title" />
		<prop name="disabled" type="bool" default="false" help="Disabled state" />
		<prop name="hide_label" type="bool" default="false" help="Hide title label on trigger" />
		<prop name="show_arrow" type="bool" default="true" help="Show dropdown indicator arrow" />
		<prop name="color" type="color" default="0x2196F3" help="Accent / selected highlight color" />
		<prop name="modal_bg_color" type="color" default="0xFFFFFF" help="Modal popup background color" />
		<prop name="modal_text_color" type="color" default="0x141414" help="Modal popup text color" />
		<prop name="height" type="px" default="48" help="Height of the trigger control" />
	</api>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="48"
			radius="12"
			bg_color="0x727272"
			bg_opa="20%"
			pad_hor="12"
			pad_ver="6"
			border_width="0"
			clip_corner="true"
		/>
	</styles>

	<view
		name="main"
		extends="lv_obj"
		scrollable="false"
	>
		<remove_style_all />
		<style name="style_base" />
	</view>
</widget>
