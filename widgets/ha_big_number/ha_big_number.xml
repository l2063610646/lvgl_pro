<widget>
	<previews>
		<preview width="320" height="240" style_bg_color="0xeee" />
	</previews>

	<api>
		<enumdef name="unit_position_def">
			<enum name="HA_BIG_NUMBER_UNIT_TOP" value="0" />
			<enum name="HA_BIG_NUMBER_UNIT_BOTTOM" value="1" />
		</enumdef>
		<prop name="value" type="int" />
		<prop name="decimal_places" type="int" />
		<prop name="unit" type="string" />
		<prop name="unit_position" type="enum:unit_position_def" default="HA_BIG_NUMBER_UNIT_BOTTOM" />
		<prop name="text_color" type="color" />
	</api>

	<styles>
		<style
			name="style_base"
			bg_opa="0%"
			layout="flex"
			flex_flow="row"
			flex_main_place="center"
			flex_cross_place="end"
			flex_track_place="start"
			width="content"
			height="50"
		/>
		<style name="style_addon" width="content" height="50" pad_top="10" pad_bottom="10" layout="flex" />
		<style
			name="style_addon_top"
			flex_flow="column_reverse"
			flex_main_place="center"
			flex_cross_place="start"
			flex_track_place="end"
		/>
		<style name="style_addon_bottom" flex_flow="row" flex_main_place="start" flex_cross_place="end" />
		<style name="debug" bg_color="0xFF0000" bg_opa="100%" />
	</styles>

	<view extends="lv_obj" scrollable="false">
		<remove_style_all />
		<style name="style_base" />

		<lv_label name="integer_label" text="99" style_text_font="roboto_regular_48_4" style_pad_all="0" />

		<lv_obj name="addon" clickable="false" scrollable="false">
			<remove_style_all />
			<style name="style_addon" />
			<style name="style_addon_top" />
			<lv_label name="decimal_label" text=".99" style_text_font="roboto_regular_20_4" style_pad_all="0" />
			<lv_label name="unit_label" text="%" style_text_font="roboto_regular_16_4" style_pad_all="0" />
		</lv_obj>
	</view>
</widget>
